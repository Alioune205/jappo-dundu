# Les motifs sont relatifs à la racine du contexte : "**/" est nécessaire
# pour exclure aussi les sous-dossiers.

# Git
.git
.gitignore
**/.gitkeep

# Python
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache

# Environnements virtuels
venv
env
ENV
.venv

# IDE / OS
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Secrets et configuration locale
.env
.env.*

# Artefacts locaux (générés dans le conteneur ou montés en volume)
staticfiles
ml/trained_models/*.joblib
ml/trained_models/*.pkl
ml/trained_models/*.tmp
**/*.sqlite3
**/*.db
**/*.log
htmlcov
.coverage

# Documentation et fichiers Docker
**/*.md
Dockerfile
docker-compose*.yml
