# ============================================================
# Jappo Dundu — Variables d'environnement (développement local)
# ============================================================
# Copiez ce fichier sous le nom ".env" et adaptez les valeurs.
# Ne commitez JAMAIS le fichier .env !
# Production : voir deploy/.env.example et deploy/README.md

# --- Django ---
# DEBUG vaut False par défaut : il faut l'activer explicitement en local.
DEBUG=True
# Obligatoire dès que DEBUG=False. Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL/PostGIS (conteneur "db" de docker-compose.yml) ---
# DB_ENGINE=django.contrib.gis.db.backends.postgis pour GeoDjango
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jappo_db
DB_USER=postgres
DB_PASSWORD=postgres
# "localhost" si Django tourne sur le poste ; docker compose force "db".
DB_HOST=localhost
DB_PORT=5432

# --- Redis / WebSockets ---
# Vide : channel layer en mémoire (un seul processus, suffisant en local).
REDIS_URL=redis://localhost:6379/1

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS (frontend React en développement : CRA 3000, Vite 5173) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Machine Learning ---
ML_MODEL_DIR=ml/trained_models
# Seuils de risque en jours de stock (à valider avec le CNTS)
ML_SHORTAGE_CRITICAL_DAYS=2
ML_SHORTAGE_WARNING_DAYS=5

# --- Journalisation ---
LOG_LEVEL=INFO
# LOG_FILE=jappo_dundu.log
