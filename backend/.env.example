# ============================================================
# Jappo Dundu — Variables d'environnement (développement local)
# ============================================================
# Copiez ce fichier sous le nom ".env" et adaptez les valeurs.
# Ne commitez JAMAIS le fichier .env !
# Production : voir deploy/.env.example et deploy/README.md

# --- Django ---
# DEBUG vaut False par défaut : il faut l'activer explicitement en local.
DEBUG=True
# Obligatoire dès que DEBUG=False. Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL/PostGIS (conteneur "db" de docker-compose.yml) ---
# DB_ENGINE=django.contrib.gis.db.backends.postgis pour GeoDjango
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jappo_db
DB_USER=postgres
DB_PASSWORD=postgres
# Adresse IPv4 explicite si Django tourne sur le poste (docker compose force "db").
# Éviter "localhost" sous Windows : il est d'abord résolu en IPv6 (::1) alors que
# le conteneur n'écoute qu'en IPv4, soit ~2 s perdues à CHAQUE requête.
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis / WebSockets ---
# Vide : channel layer en mémoire (un seul processus, suffisant en local).
REDIS_URL=redis://127.0.0.1:6379/1
# Cache partagé (throttling, tickets WebSocket, suivi des prédictions).
# Vide : cache mémoire local, suffisant avec un seul processus. Requis en production.
# CACHE_REDIS_URL=redis://127.0.0.1:6379/2
# Durée de vie (s) d'un ticket de connexion WebSocket (POST /api/realtime/ticket/).
# REALTIME_TICKET_TTL=30

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS (frontend React en développement : CRA 3000, Vite 5173) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Machine Learning ---
ML_MODEL_DIR=ml/trained_models
# Seuils de risque en jours de stock (à valider avec le CNTS)
ML_SHORTAGE_CRITICAL_DAYS=2
ML_SHORTAGE_WARNING_DAYS=5
# Prédictions à la demande hors de la requête HTTP (False : calcul dans la requête).
# ML_PREDICT_ASYNC=True

# --- Limitation de débit (format DRF : nombre/période) ---
# THROTTLE_LOGIN_RATE=10/minute
# THROTTLE_ML_PREDICT_RATE=30/hour
# THROTTLE_USER_BURST_RATE=30/second
# THROTTLE_USER_SUSTAINED_RATE=10000/hour

# --- Sécurité HTTPS / proxy : inutile en local (DEBUG=True) ---
# Les valeurs de production sont fixées dans deploy/ (docker-compose.prod.yml).
# HTTPS_ENABLED=False
# BEHIND_PROXY=False
# NUM_PROXIES=0
# CSRF_TRUSTED_ORIGINS=
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False
# CORS_ALLOW_CREDENTIALS=False

# --- E-mail : vide = e-mails affichés dans la console ---
# EMAIL_HOST=smtp.example.sn
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Journalisation ---
LOG_LEVEL=INFO
# LOG_FILE=jappo_dundu.log
