# Interface web Jappo Dundu — variables facultatives (copier en .env.local)

# Développement : adresse du backend Django vers laquelle Vite relaie /api et /ws.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Production : laisser vide quand le frontend et l'API partagent le même domaine
# (configuration Caddy fournie dans deploy/). À renseigner uniquement si l'API
# est servie sur un autre domaine (ex. https://api.jappodundu.sn).
VITE_API_BASE_URL=

# Instance de démonstration uniquement : « true » affiche les comptes de test
# (et leur mot de passe) sur l'écran de connexion. À NE JAMAIS activer en
# production. Toujours actif en développement (npm run dev).
VITE_SHOW_DEMO_ACCOUNTS=false
