# Adresse du backend vue depuis le téléphone (copier en .env).
# - téléphone sur le même Wi-Fi que le PC : IP locale du PC, ex. http://192.168.1.20:8000
#   (« localhost » désignerait le téléphone lui-même) ;
# - émulateur Android : http://10.0.2.2:8000 ;
# - production : https://jappodundu.sn
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Connexion sociale (facultatif ; voir README « Connexion Google, Facebook, Apple »).
# Sans valeur, le bouton n'apparaît qu'en développement, avec une explication.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
