{
  "expo": {
    "name": "Jappo Dundu",
    "slug": "jappo-dundu",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jappodundu",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0c0f",
    "primaryColor": "#d92d20",
    "description": "Donneurs de sang du Sénégal : alertes des hôpitaux proches, réponse en un geste, historique des dons.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sn.jappodundu.donneurs",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position permet de vous montrer les demandes de sang des hôpitaux proches. Elle n'est jamais transmise aux hôpitaux."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "sn.jappodundu.donneurs",
      "adaptiveIcon": {
        "backgroundColor": "#D92D20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F7",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#0A0C0F"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position permet de vous montrer les demandes de sang des hôpitaux proches. Elle n'est jamais transmise aux hôpitaux.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D92D20",
          "defaultChannel": "blood-alerts"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
