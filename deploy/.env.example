# ============================================================
# Jappo Dundu — Variables de PRODUCTION
# ============================================================
# cp .env.example .env   puis remplir chaque valeur.
# Ce fichier .env ne doit JAMAIS être commité.
#
# Fixées par docker-compose.prod.yml (ne pas les définir ici) :
#   DEBUG=False, DB_HOST, DB_PORT, REDIS_URL, CACHE_REDIS_URL,
#   BEHIND_PROXY=True, NUM_PROXIES=1.
#
# Frontend : les variables VITE_* sont lues au BUILD (npm run build), pas ici.
#   VITE_SHOW_DEMO_ACCOUNTS doit rester absente ou à false en production :
#   sinon les identifiants de démonstration sont compilés dans le JavaScript.

# --- Domaine public ---
# Nom de domaine pointant vers le serveur (HTTPS automatique).
# ":80" uniquement pour un test local en HTTP.
SITE_ADDRESS=jappodundu.example.sn
ALLOWED_HOSTS=jappodundu.example.sn
CSRF_TRUSTED_ORIGINS=https://jappodundu.example.sn
# Mettre False uniquement pour un test local en HTTP (SITE_ADDRESS=:80).
HTTPS_ENABLED=True

# --- Django ---
# Obligatoire, 50 caractères aléatoires minimum :
#   docker run --rm python:3.14-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# --- Base de données ---
DB_NAME=jappo_db
DB_USER=jappo
# Obligatoire : mot de passe long et aléatoire
DB_PASSWORD=

# --- CORS : uniquement si un domaine tiers doit appeler l'API ---
# (le frontend est servi sur le même domaine : laisser vide)
CORS_ALLOWED_ORIGINS=

# --- E-mail (SMTP) : codes de mot de passe oublié, notifications ---
# Sans EMAIL_HOST, AUCUN e-mail n'est envoyé (rien n'est écrit dans les
# journaux : ils contiendraient les codes de réinitialisation).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Jappo Dundu <no-reply@jappodundu.example.sn>

# --- Mot de passe oublié : SMS (Orange Sénégal) ---
# OBLIGATOIRE en production : « console » est refusé hors DEBUG, et sans SMS
# ni SMTP aucun code de réinitialisation ne peut partir.
SMS_BACKEND=orange
SMS_ORANGE_CLIENT_ID=
SMS_ORANGE_CLIENT_SECRET=
# Numéro expéditeur du contrat Orange, ex. +2210000
SMS_ORANGE_SENDER=
THROTTLE_PASSWORD_RESET_RATE=5/hour
THROTTLE_PASSWORD_RESET_CONFIRM_RATE=20/hour

# --- Connexion Google / Apple / Facebook (application mobile) ---
# Vide = fournisseur désactivé (le serveur répond 503).
# Identifiants client OAuth Google (Android, iOS, web), séparés par des virgules
GOOGLE_CLIENT_IDS=
# Identifiant d'application iOS, ex. sn.jappodundu.donneurs
APPLE_AUDIENCES=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Notifications push (service Expo -> FCM / APNs) ---
PUSH_ENABLED=True
PUSH_ASYNC=True
# Requis si « enhanced push security » est activé sur le projet EAS
PUSH_EXPO_ACCESS_TOKEN=
# Donneurs notifiés au plus par demande de sang (les plus proches)
PUSH_MAX_DONORS=50

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Machine Learning ---
ML_SHORTAGE_CRITICAL_DAYS=2
ML_SHORTAGE_WARNING_DAYS=5
# Prédictions à la demande en arrière-plan (ne pas désactiver en production :
# le calcul gèlerait l'API pendant plusieurs secondes).
ML_PREDICT_ASYNC=True
# Délai (s) après lequel une prédiction non terminée est déclarée perdue
# (processus redémarré pendant le calcul) et peut être relancée.
ML_JOB_STALE_SECONDS=900

# --- Temps réel ---
# Durée de vie (s) des tickets de connexion WebSocket à usage unique.
REALTIME_TICKET_TTL=30

# --- Limitation de débit (format DRF : nombre/période) ---
THROTTLE_LOGIN_RATE=10/minute
THROTTLE_ML_PREDICT_RATE=30/hour
THROTTLE_USER_BURST_RATE=30/second
THROTTLE_USER_SUSTAINED_RATE=10000/hour

# --- HSTS (en-tête émis aussi par Caddy) ---
SECURE_HSTS_SECONDS=31536000
# True uniquement après inscription du domaine sur hstspreload.org
SECURE_HSTS_PRELOAD=False

# --- Frontend : dossier du build React (npm run build) ---
FRONTEND_DIST_DIR=../frontend/dist

# --- Ports publics (défauts : 80 / 443) ---
HTTP_PORT=80
HTTPS_PORT=443

LOG_LEVEL=INFO
